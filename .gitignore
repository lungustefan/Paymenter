# Dependencies / build output
/node_modules
/.next
/out
next-env.d.ts
*.tsbuildinfo
/src/generated
/public/build
/public/default/*
/public/storage
/.registry-hash
/coverage

# Local configuration
.env
.env.backup
.env.production
.env.update-backup
/storage/*.key

# Logs
npm-debug.log
yarn-error.log
pnpm-debug.log

# Editors
/.fleet
/.idea
/.vscode

# Third-party themes and extensions (the bundled ones are tracked)
themes/*
!themes/default
extensions/Others/Pages
extensions/Servers/LicenseManager
extensions/Servers/Proxmox

# Local data
/storage/app/public/*
!/storage/app/public/.gitkeep
/storage/app/invoices/*
/storage/app/tickets/*
/storage/logs/*
!/storage/logs/.gitkeep
/storage/framework/*
