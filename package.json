{
    "name": "paymenter",
    "version": "2.0.0-rc.2",
    "private": true,
    "description": "Paymenter is a self-hosted, open-source, and free invoicing and billing software built with Next.js.",
    "keywords": [
        "invoicing",
        "billing",
        "nextjs",
        "open-source",
        "self-hosted",
        "subscription",
        "payment",
        "invoice",
        "billing software"
    ],
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "node scripts/generate-registry.mjs && next dev",
        "build": "node scripts/generate-registry.mjs && node scripts/build-themes.mjs && next build",
        "start": "next start",
        "worker": "tsx src/cli/index.ts worker",
        "paymenter": "tsx src/cli/index.ts",
        "migrate": "tsx src/cli/index.ts migrate",
        "registry": "node scripts/generate-registry.mjs",
        "lint": "tsc --noEmit",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@next/env": "^16.4.0",
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/typography": "^0.5.16",
        "@tiptap/core": "^3.31.4",
        "@tiptap/extension-image": "^3.31.4",
        "@tiptap/extension-placeholder": "^3.31.4",
        "@tiptap/extension-subscript": "^3.31.4",
        "@tiptap/extension-superscript": "^3.31.4",
        "@tiptap/extension-table": "^3.31.4",
        "@tiptap/extension-text-align": "^3.31.4",
        "@tiptap/pm": "^3.31.4",
        "@tiptap/react": "^3.31.4",
        "@tiptap/starter-kit": "^3.31.4",
        "bcryptjs": "^3.0.2",
        "chart.js": "4.5.1",
        "dejavu-fonts-ttf": "^2.37.3",
        "drizzle-orm": "^0.45.0",
        "easymde": "^2.20.0",
        "email-reply-parser": "^2.3.9",
        "fflate": "^0.8.3",
        "filepond": "^4.32.12",
        "filepond-plugin-file-validate-size": "^2.2.8",
        "filepond-plugin-file-validate-type": "^1.2.9",
        "filepond-plugin-image-preview": "^4.6.12",
        "imapflow": "^2.3.0",
        "ioredis": "^6.0.0",
        "mailparser": "^3.9.37",
        "markdown-it": "^15.0.2",
        "markdown-it-task-lists": "^2.1.1",
        "mysql2": "^3.14.0",
        "next": "^16.0.0",
        "nodemailer": "^7.0.0",
        "otplib": "^12.0.1",
        "pdfkit": "^0.20.2",
        "qrcode": "^1.5.4",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "sharp": "^0.35.5",
        "sortablejs": "^1.15.7",
        "tsx": "^4.19.0",
        "vanilla-colorful": "^0.7.2",
        "web-push": "^3.6.7",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.11",
        "@types/mailparser": "^3.9.0",
        "@types/markdown-it": "^14.2.0",
        "@types/node": "^22.0.0",
        "@types/nodemailer": "^6.4.17",
        "@types/pdfkit": "^0.17.6",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/sortablejs": "^1.15.9",
        "@types/web-push": "^3.6.4",
        "drizzle-kit": "^0.31.0",
        "heroicons": "2.2.0",
        "postcss": "^8.5.0",
        "remixicon": "^4.9.1",
        "tailwindcss": "^4.1.11",
        "typescript": "^5.9.0",
        "vitest": "^3.2.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "sharp",
            "unrs-resolver"
        ]
    }
}
