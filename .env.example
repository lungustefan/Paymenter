APP_NAME=Paymenter
APP_ENV=production
# Generate with `pnpm paymenter key:generate` (writes to .env)
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:3000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=paymenter
DB_USERNAME=paymenter
DB_PASSWORD=

BROADCAST_CONNECTION=log
# file | database | redis
CACHE_STORE=redis
# sync runs jobs inline; redis/database both use the `jobs` table, processed by `pnpm worker`
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
